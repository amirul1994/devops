authorityKeyIdentifier=keyid,issuer
basicConstraints=CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth,clientAuth
subjectAltName = @alt_names

[alt_names]
DNS.1 = vault.vault.svc.cluster.local
DNS.2 = vault.vault.svc
DNS.3 = vault
DNS.4 = localhost
DNS.5 = vault-0.vault-internal
DNS.6 = vault-1.vault-internal
DNS.7 = vault-2.vault-internal
DNS.8 = *.vault-internal
DNS.9 = *.vault-internal.vault.svc.cluster.local
IP.1 = 127.0.0.1
